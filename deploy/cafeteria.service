# Servicio systemd: mantiene el backend (API + frontend) encendido y lo arranca con la VM.
# Se instala con el comando del paso 14 de la guía (reemplaza USUARIO y RUTA).
[Unit]
Description=Dashboard Cafeteria SENA (Node/Express)
After=network-online.target
Wants=network-online.target

[Service]
User=USUARIO
WorkingDirectory=RUTA/backend
# NODE_DIR = carpeta de node (con nvm: /home/azureuser/.nvm/versions/node/vXX/bin)
Environment=PATH=NODE_DIR:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/env node server.js
Restart=always
RestartSec=5
Environment=NODE_ENV=production

[Install]
WantedBy=multi-user.target